PORT=4100
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5180

# Max SOL per request
MAX_AIRDROP_SOL=5
# Requests per IP per window
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Default RPC endpoints (override with private RPCs if you have them)
DEVNET_RPC_URL=https://api.devnet.solana.com
TESTNET_RPC_URL=https://api.testnet.solana.com
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Optional faucet wallet (base58 secret key or JSON byte array).
# Used as a fallback when requestAirdrop fails (e.g. devnet faucet rate-limited),
# and REQUIRED for mainnet, which has no airdrop faucet.
FAUCET_SECRET_KEY=
# Mainnet transfers spend real SOL. Must be explicitly enabled.
ALLOW_MAINNET=false

# Jupiter swap aggregator (mainnet only). The lite endpoint needs no key; set
# JUPITER_API_URL=https://api.jup.ag/swap/v1 plus JUPITER_API_KEY for higher limits.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
